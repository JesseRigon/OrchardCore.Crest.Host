<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <add key="OrchardCore Local" value="/workspaces/local-nuget-feed" />
    <!-- In-repo feed for standalone ("production mode") clones: dev/dev.sh packs the
         modules/OrchardCore fork into this folder when the sibling dev feed above is
         absent. Both directories must exist for restore to run; dev.sh creates them. -->
    <add key="OrchardCore In-Repo" value="local-nuget-feed" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="NuGet">
      <package pattern="*" />
      <!-- Real, separately-published translations packages (the "All" meta-package and
           its per-culture dependents) are not part of the OrchardCore monorepo source
           tree, so they are never in the local feeds. This pattern is more specific
           than "OrchardCore*" below and wins. -->
      <package pattern="OrchardCore.Translations*" />
    </packageSource>
    <packageSource key="OrchardCore Local">
      <package pattern="OrchardCore*" />
      <!-- Stock theme/sample packages are packed into the local feed too but do not
           share the OrchardCore name prefix; without these mappings restore routes
           them to nuget.org and silently falls back to stale cache copies with
           mismatched assembly versions. -->
      <package pattern="TheAdmin*" />
      <package pattern="TheAgencyTheme*" />
      <package pattern="TheBlogTheme*" />
      <package pattern="TheComingSoonTheme*" />
      <package pattern="TheTheme*" />
      <package pattern="SafeMode*" />
      <package pattern="BaseThemeSample*" />
      <package pattern="DerivedThemeSample*" />
      <package pattern="Examples.Features*" />
    </packageSource>
    <packageSource key="OrchardCore In-Repo">
      <package pattern="OrchardCore*" />
      <package pattern="TheAdmin*" />
      <package pattern="TheAgencyTheme*" />
      <package pattern="TheBlogTheme*" />
      <package pattern="TheComingSoonTheme*" />
      <package pattern="TheTheme*" />
      <package pattern="SafeMode*" />
      <package pattern="BaseThemeSample*" />
      <package pattern="DerivedThemeSample*" />
      <package pattern="Examples.Features*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
